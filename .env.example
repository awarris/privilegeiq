# Local PostgreSQL. Docker maps the container to host port 55473 to avoid common local conflicts.
DATABASE_URL="postgresql://postgres:postgres@localhost:55473/privilegeiq?schema=public"

# Prisma CLI connection. Locally this can be the same URL as DATABASE_URL.
# For Vercel + Supabase, prefer:
#   DATABASE_URL = Supabase Transaction Pooler URL for application/runtime traffic.
#   DIRECT_URL   = Supabase Session Pooler or direct URL for Prisma CLI operations.
DIRECT_URL="postgresql://postgres:postgres@localhost:55473/privilegeiq?schema=public"

# Demo administrator used to protect the public hackathon deployment.
DEMO_ADMIN_EMAIL="admin@privilegeiq.dev"
DEMO_ADMIN_PASSWORD="ChangeMeBeforeDeploying!"

# Generate a strong random value before deployment, for example:
# openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
